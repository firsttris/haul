# Development settings. Copy to `.env`; `cargo run -p haul` reads it automatically.
# Variables already set in the environment take precedence.

APP_SECRET=dev-secret
HAUL_CONFIG_DIR=./.data/config
HAUL_TMP_DIR=./.data/tmp
HAUL_DONE_DIR=./.data/done
HAUL_BUILTIN_PLUGINS=./plugins/dist
HAUL_LISTEN=127.0.0.1:8080
HAUL_CNL_LISTEN=127.0.0.1:9666

# Until the UI is built into the binary, :8080 redirects here (Vite dev server).
HAUL_DEV_UI=http://localhost:5173

# Creates the web login on first start (otherwise the UI asks for it).
HAUL_USER=admin
HAUL_PASSWORD=adminadmin

# User-Agent sent to hosters (default: a desktop browser). Some hosters treat download
# managers differently from browsers, e.g. no login captcha.
# HAUL_USER_AGENT=

# Folders the "Fertig" view can move things into, e.g. the renamer's inbox (Name=/absolute/path;…).
# HAUL_MOVE_TARGETS=Renamer=/media/inbox;Archiv=/mnt/archiv

RUST_LOG=info,sqlx=warn
