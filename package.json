{
  "name": "haul",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "cargo run -p haul",
    "dev:ui": "pnpm --filter @haul/ui dev",
    "build": "pnpm build:plugins && pnpm --filter @haul/ui build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:extension": "pnpm --filter @haul/extension build",
    "test": "pnpm --filter @haul/ui i18n && vitest run",
    "typecheck": "pnpm -r typecheck",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^10.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~7.0.0",
    "vitest": "^5.0.0"
  }
}
