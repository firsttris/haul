{
  "name": "haul",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "ui",
    "extension"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "cargo run -p haul",
    "dev:ui": "bun run --cwd ui dev",
    "build": "bun run build:plugins && bun run --filter @haul/ui build",
    "build:plugins": "bun scripts/build-plugins.ts",
    "build:extension": "bun run --filter @haul/extension build",
    "test": "bun test ./scripts/dev.test.ts && bun run --filter @haul/ui i18n && bun --bun vitest run",
    "typecheck": "bun run --workspaces typecheck",
    "screenshots": "bun --bun playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.0",
    "typescript": "~7.0.0",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
